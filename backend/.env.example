# ---------------------------------------------------------------------------
# Agrownex backend (Express) — copy to backend/.env and adjust.
# Never commit real credentials. Seed values are local-development defaults.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=5000

# MongoDB connection string.
# Local option (install MongoDB Community Server, then ensure the service runs):
#   MONGODB_URI=mongodb://127.0.0.1:27017/agrownex
# Atlas option: paste your SRV connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/agrownex

# URL of the FastAPI ML service (ml-service/). Internal service call.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=15000

# Comma-separated list of allowed browser origins (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (requests / minute / IP for /api routes)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Optional LLM provider for the agent orchestrator.
# If LLM_PROVIDER is "none" (or key missing), the deterministic rule-based
# orchestrator is used and the response is clearly labelled as fallback mode.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=20000

# Community early-warning rule thresholds (documented defaults; tune via env)
# "attention" needs ratio >= ALERT_ATTENTION_RATIO with >= ALERT_ATTENTION_FLOOR
# recent reports; "watch" needs ratio >= ALERT_WATCH_RATIO with >= ALERT_WATCH_FLOOR.
ALERT_ATTENTION_RATIO=1.6
ALERT_WATCH_RATIO=1.22
ALERT_WATCH_FLOOR=5
ALERT_ATTENTION_FLOOR=10
